#include <stdio.h>

int main() {
    int L, N, W, H;
    
    // Read minimum dimension L and number of photos N
    if (scanf("%d", &L) != 1) return 0;
    if (scanf("%d", &N) != 1) return 0;
    
    // Loop through each photo
    for (int i = 0; i < N; i++) {
        scanf("%d %d", &W, &H);
        
        if (W < L || H < L) {
            printf("UPLOAD ANOTHER\n");
        } else if (W == H) {
            printf("ACCEPTED\n");
        } else {
            printf("CROP IT\n");
        }
    }
    
    return 0;
}
