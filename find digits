int findDigits(int n) {
    int count = 0;
    int original = n;
    
    while (original > 0) {
        int digit = original % 10;
        // Ensure digit is not 0 to avoid division by zero error
        if (digit != 0 && n % digit == 0) {
            count++;
        }
        original /= 10;
    }
    
    return count;
}
