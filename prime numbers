#include <stdio.h>

int main() {
    int n, isPrime = 1;
    
    // Read input integer n
    if (scanf("%d", &n) != 1) {
        return 0;
    }

    // Numbers less than 2 are not prime
    if (n < 2) {
        isPrime = 0;
    } else {
        // Check for factors from 2 up to sqrt(n)
        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) {
                isPrime = 0;
                break;
            }
        }
    }

    // Print 1 if prime, 0 otherwise, followed by a newline
    printf("%d\n", isPrime);

    return 0;
}
