#include <stdbool.h>

bool checkPerfectNumber(int num) {
    // 1 is not a perfect number since its only positive divisor is itself
    if (num <= 1) {
        return false;
    }

    int sum = 1; // 1 is a proper divisor for all integers > 1

    // Loop only up to the square root of num for optimal O(sqrt(N)) time
    for (int i = 2; i * i <= num; i++) {
        if (num % i == 0) {
            sum += i;
            // Add the paired divisor if it is distinct from i
            if (i * i != num) {
                sum += num / i;
            }
        }
    }

    return sum == num;
}
